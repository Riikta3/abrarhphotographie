# Envoi du formulaire de contact (Resend — https://resend.com)
# Ces variables restent côté serveur : elles ne sont jamais exposées au navigateur.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Adresse qui reçoit les demandes de devis
CONTACT_TO_EMAIL=contact@abrarh-photographie.fr
# Expéditeur — le domaine doit être vérifié chez Resend
CONTACT_FROM_EMAIL=site@abrarh-photographie.fr
